# מפתח API של Claude (חובה) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# מודל Claude לבדיקה
GRADER_MODEL=claude-sonnet-5-5

# רמת המאמץ של Claude: low / medium / high / xhigh / max
# (גבוה יותר = בדיקה יסודית יותר, איטית ויקרה יותר)
GRADER_EFFORT=high

# סיסמת כניסה לאתר (מומלץ). אם ריק — אין סיסמה.
APP_PASSWORD=

# מחרוזת סודית אקראית לחתימת עוגיית ההתחברות (חובה אם הוגדרה סיסמה)
SESSION_SECRET=change-me-to-a-long-random-string

# תיקיית הנתונים (מסד נתונים וקבצים שהועלו)
DATA_DIR=./data

# כמה עבודות לבדוק במקביל
GRADING_CONCURRENCY=3
