# לא חובה! את כל ההגדרות אפשר לקבוע במסך "הגדרות" באתר.
# ערך שמוגדר כאן גובר על מה שנשמר במסך ההגדרות.

# מפתח API של Claude — https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# מודל Claude לבדיקה
# GRADER_MODEL=claude-sonnet-5-5

# רמת המאמץ של Claude: low / medium / high / xhigh / max
# (גבוה יותר = בדיקה יסודית יותר, איטית ויקרה יותר)
# GRADER_EFFORT=high

# סיסמת כניסה לאתר. אם ריק — משתמשים בסיסמה ממסך ההגדרות (אם הוגדרה).
# APP_PASSWORD=

# מחרוזת סודית לחתימת עוגיית ההתחברות. אם ריק — נוצרת אוטומטית.
# SESSION_SECRET=

# תיקיית הנתונים (מסד נתונים וקבצים שהועלו)
# DATA_DIR=./data

# כמה עבודות לבדוק במקביל
# GRADING_CONCURRENCY=3
