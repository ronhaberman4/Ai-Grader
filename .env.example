# מפתח OpenAI (חובה) — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# מודל OpenAI לבדיקה (חייב לתמוך בתמונות ו-PDF)
OPENAI_MODEL=gpt-5.5

# רמת חשיבה למודלים מסדרת gpt-5 (low / medium / high). השאירו ריק למודלים אחרים.
OPENAI_REASONING_EFFORT=medium

# סיסמת כניסה לאתר (מומלץ). אם ריק — אין סיסמה.
APP_PASSWORD=

# מחרוזת סודית אקראית לחתימת עוגיית ההתחברות (חובה אם הוגדרה סיסמה)
SESSION_SECRET=change-me-to-a-long-random-string

# תיקיית הנתונים (מסד נתונים וקבצים שהועלו)
DATA_DIR=./data

# כמה עבודות לבדוק במקביל
GRADING_CONCURRENCY=3
